{
  "name": "playwright-visual-cloud-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r --if-present check",
    "setup": "pnpm install",
    "dev": "pnpm --filter @playwright-visual-cloud/website dev",
    "build:cli": "pnpm --filter playwright-visual-cloud build",
    "build:server": "pnpm --filter @playwright-visual-cloud/website build",
    "build:ui": "pnpm --dir apps/website build",
    "build:website": "pnpm --dir apps/website build",
    "fmt": "oxlint --fix && oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm -r typecheck",
    "typecheck:cli": "pnpm --filter playwright-visual-cloud typecheck",
    "typecheck:server": "pnpm --filter @playwright-visual-cloud/website exec tsc -p tsconfig.worker.json --noEmit",
    "typecheck:website": "pnpm --filter @playwright-visual-cloud/website typecheck",
    "deploy": "pnpm --filter @playwright-visual-cloud/website deploy",
    "dev:server:local": "pnpm setup && pnpm --filter @playwright-visual-cloud/website run migrate:local && pnpm --filter @playwright-visual-cloud/website dev",
    "dev:server": "pnpm setup && pnpm --filter @playwright-visual-cloud/website dev",
    "dev:ui": "pnpm --filter @playwright-visual-cloud/website dev",
    "dev:website": "pnpm --filter @playwright-visual-cloud/website dev"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0"
  }
}
