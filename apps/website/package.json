{
  "name": "@playwright-visual-cloud/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.worker.json --noEmit && vite build",
    "dev": "vite",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm check && wrangler deploy",
    "migrate": "wrangler d1 migrations apply pvc --remote",
    "migrate:local": "wrangler d1 migrations apply pvc --local",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check": "pnpm typecheck && pnpm build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@ngriffin_uk/auth-cookie": "^0.2.4",
    "@ngriffin_uk/auth-core": "^0.5.1",
    "@ngriffin_uk/auth-crypto": "^1.1.1",
    "@ngriffin_uk/auth-encoding": "^0.2.4",
    "@ngriffin_uk/auth-jwt": "^2.0.0",
    "@ngriffin_uk/auth-oauth2": "^4.0.1",
    "@ngriffin_uk/auth-protocol": "^0.1.1",
    "@ngriffin_uk/auth-provider-github": "^4.0.0",
    "@ngriffin_uk/auth-request": "^0.2.4",
    "hono": "^4.13.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/workers-types": "^5.20260817.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  }
}
